# @plugin(@varlock/1password-plugin)
# @defaultSensitive=false
# @defaultRequired=infer
# ---

# Resolved from 1Password by the ignored .env.local configuration.
# @required @sensitive @type=string
ANTHROPIC_API_KEY=

# Path to a user-installed ggml model; never downloaded by the app.
# @type=string
WHISPER_MODEL=

# @type=string
WHISPER_BINARY=whisper-cli

# @type=string
CLAUDE_MODEL=claude-haiku-4-5-20251001

# @type=port
PORT=4317

# @type=number
MAX_UPLOAD_MB=4096

# @type=string
SHOWNOTES_OUT=output
