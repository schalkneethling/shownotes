{
  "$schema": "https://calavera.schalkneethling.com/calavera.config.schema.json",
  "version": 1,
  "profile": "modern",
  "packageManager": "npm",
  "integrations": [
    "editorconfig",
    "typescript",
    "varlock",
    "oxlint",
    "oxlint-eslint",
    "oxlint-typescript",
    "oxlint-unicorn",
    "oxlint-oxc",
    "oxlint-node",
    "oxlint-promise",
    "oxlint-vitest",
    "oxfmt",
    "stylelint",
    "stylelint-standard",
    "stylelint-baseline"
  ],
  "scripts": {
    "lint": true,
    "lint:fix": true,
    "format": true,
    "format:check": true,
    "typecheck": true,
    "quality": true
  },
  "ai": [
    {
      "id": "skill-calavera"
    },
    {
      "id": "skill-code-review"
    },
    {
      "id": "skill-more-secure-dependabot-config"
    },
    {
      "id": "skill-release-with-confidence"
    }
  ],
  "integrationOptions": {
    "stylelint-baseline": {
      "available": "widely",
      "severity": "warning"
    }
  }
}
